# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl

# Terraform variables (may contain secrets)
terraform.tfvars
*.auto.tfvars

# zsec config (contains credentials)
.zsecrc
.zsecrc-*

# Terraform binary (downloaded by zsec)
ztgw/bin/

# SSH keys (generated by Terraform)
*.pem
*.pem.pub

# OS
.DS_Store
Thumbs.db
